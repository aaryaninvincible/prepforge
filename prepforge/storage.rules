rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // User profile avatars (Max 2MB, images only)
    match /avatars/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
    }

    // Excel Tracker workbooks uploaded for import (Max 10MB, spreadsheet formats only)
    match /imports/{userId}/{fileName} {
      allow read, write: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && (
          request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.spreadsheetml.sheet') ||
          request.resource.contentType.matches('text/csv') ||
          request.resource.contentType.matches('application/json')
        );
    }

    // Public learning assets managed by admins
    match /learningAssets/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && request.resource.size < 25 * 1024 * 1024;
    }
  }
}
