{
  "name": "prepforge",
  "private": true,
  "version": "1.0.0",
  "description": "Production-oriented technical interview & placement preparation platform for Aryan, Parsa, and public engineering cohorts.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore,storage 'vitest run tests/security-rules.test.ts'",
    "seed:admin": "ts-node scripts/setAdminClaim.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "@tanstack/react-query": "^5.56.2",
    "firebase": "^10.14.0",
    "lucide-react": "^0.446.0",
    "recharts": "^2.12.7",
    "react-hook-form": "^7.53.0",
    "zod": "^3.23.8",
    "@hookform/resolvers": "^3.9.0",
    "xlsx": "^0.18.5",
    "exceljs": "^4.4.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.2",
    "canvas-confetti": "^1.9.4"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2",
    "@firebase/rules-unit-testing": "^3.0.3"
  }
}
