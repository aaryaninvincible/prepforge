# ============================================================================
# PREPFORGE — ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env.local and fill in your Firebase & Sandbox credentials.
# Never commit .env.local, service-account keys, or private API secrets to Git.
# ============================================================================

# Firebase Client SDK Configuration
VITE_FIREBASE_API_KEY=AIzaSy_YOUR_FIREBASE_API_KEY_PLACEHOLDER
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase App Check (reCAPTCHA v3 / Enterprise Site Key)
VITE_FIREBASE_APP_CHECK_SITE_KEY=6Lc_YOUR_RECAPTCHA_V3_SITE_KEY_PLACEHOLDER
VITE_ENABLE_APP_CHECK=true

# Cloud Functions / Trusted API Base URL
VITE_FUNCTIONS_BASE_URL=https://us-central1-your-project-id.cloudfunctions.net

# Isolated Python Execution Service Configuration
# Supported modes: "worker" (browser Web Worker sandbox) | "cloud_function" (Judge0 / Piston via Firebase Function)
VITE_CODE_EXECUTION_MODE=worker
VITE_SANDBOX_EXECUTION_API_URL=https://us-central1-your-project-id.cloudfunctions.net/executePythonCode
VITE_SANDBOX_TIMEOUT_MS=3000
VITE_SANDBOX_MEMORY_LIMIT_MB=128
